// One directory's OWN image tally (S65, Sources sidebar) — directory_path is
// the canonical derived parent-directory form (same as
// get_distinct_directory_paths), so the keys match the tree exactly.
dictionary DirectoryImageCount {
    string directory_path;
    i64 image_count;
};

// One capture day's image tally (S65, Dates sidebar) — day is the
// "YYYY:MM:DD" prefix (same as get_distinct_date_strings).
dictionary CaptureDayImageCount {
    string day;
    i64 image_count;
};

// One directory's folder-sync bookkeeping row (S68; Docs/DESIGN-Folder-Sync.md):
// the directory's on-disk mtime (epoch seconds, exactly as stat reports it)
// recorded when the directory was last scanned or synced. directory_path is the
// canonical derived parent-directory form (same key set as
// get_distinct_directory_paths / DirectoryImageCount).
dictionary DirectorySyncState {
    string directory_path;
    i64 last_sync_mtime;
};

// One materialized keyword row (Session 45), returned to Swift. status: 1 =
// active/retained, 0 = hidden. created_at / hidden_at are VARCHAR-cast
// timestamps (hidden_at null while active). label = last path segment; path =
// root->node, U+001F-separated (the UI renders a visible glyph in its place).
dictionary KeywordRow {
    string label;
    string path;
    i32 status;
    i32 origin;
    string created_at;
    string? hidden_at;
};

// A distinct (label, path) node — the keyword vocabulary, for autocomplete and
// the (future) tree browser.
dictionary KeywordNode {
    string label;
    string path;
};

// Settings → Keywords management aggregate row. Counts are over raw keyword
// rows, grouped by path. visible_count = status 1; hidden_count = non-visible;
// collection_count = rows whose collection switch is on.
dictionary KeywordManagementRow {
    string label;
    string path;
    i32 origin;
    i64 visible_count;
    i64 hidden_count;
    i64 collection_count;
    i64 total_count;
};

// Lightroom import — per-chunk merge result. image_ids is aligned to the input
// order (image-row ids for merge_lightroom_records; video-row ids for
// merge_lightroom_videos) so the Swift keyword pass can attach by id.
dictionary MergeChunkResult {
    u64 inserted;
    u64 updated;
    sequence<i64> image_ids;
};

// Lightroom import — one VIDEO record. No ImageMetadata analogue (videos carry
// duration/frame_rate/has_audio/video_kind, no EXIF). directory_path is derived
// Rust-side. Times are Unix epoch (Swift converts LR's Cocoa modTime + decodes
// AgVideoInfo's hex QuickTime rationals).
dictionary LightroomVideoRecord {
    string file_path;
    u64 file_size;
    string file_name;
    string? file_extension;
    i64 created_timestamp;
    i64 modified_timestamp;
    string? capture_datetime;
    u32? pixel_width;
    u32? pixel_height;
    f64? duration_seconds;
    f64? frame_rate;
    boolean? has_audio;
    string? video_kind;
    u8? rating;
    string? flag;
    string? color_label;
};

// Parsed components of a filename, returned by parse_filename.
// See DESIGN-Duplicate-Consolidation.md §7 for the parsing contract.
//
// stem: everything before the last '.' in the filename, ORIGINAL CASE preserved.
//   The duplicate-detection partition applies LOWER() at the SQL boundary
//   (Section 12), so the stored form keeps display case while comparison is
//   case-folded.
// extension_lower: everything after the last '.', ALWAYS LOWERCASE. Set to
//   the synthetic placeholder "metype" (DOS-8.3-era mnemonic for "missing
//   extension type") when the filename is malformed (no dot, leading dot,
//   trailing dot, or empty filename).
//   Named extension_lower rather than extension because "extension" is a
//   reserved keyword in Swift and would require backtick-escaping at every
//   call site of the generated binding.
// kind: classify_extension(extension_lower). Always Other for malformed cases.
dictionary ParsedFilename {
    string stem;
    string extension_lower;
    ImageKind kind;
};

// Represents the metadata for a single image file
// Populated by Swift/ImageIO, consumed by Rust/DuckDB
dictionary ImageMetadata {
    string file_path;
    u64 file_size;
    string file_name;
    string? file_extension;
    i64 created_timestamp;
    i64 modified_timestamp;

    // Camera/capture metadata
    string? camera_make;
    string? camera_model;
    string? lens_model;
    f64? focal_length;
    f64? aperture;
    f64? shutter_speed;
    u32? iso;
    string? capture_datetime;

    // Image properties
    u32? pixel_width;
    u32? pixel_height;
    string? color_space;
    u32? bit_depth;

    // GPS coordinates (if present)
    f64? gps_latitude;
    f64? gps_longitude;
    f64? gps_altitude;

    // IPTC/copyright
    string? copyright;
    string? creator;
    string? description;

    // Organization metadata
    u8? rating;
    string? flag;
    string? color_label;

    // S67 (Copy and Import): the source record's in-app rotation, inherited
    // by a catalogued copy. APPENDED LAST with a default (the S65 wire-struct
    // growth rule) so every existing Swift construction site compiles
    // untouched. None at INSERT -> schema default 0; None at UPDATE preserves.
    i32? rotation = null;

    // === Video / unified-media (Step 2a; DESIGN-Video-Schema-Unified-Table.md §4b).
    // Appended LAST, each with a UDL default (= false / = null) per the same
    // wire-struct growth rule, so every existing Swift construction site
    // (makeImageMetadata, the LR import) compiles untouched and produces stills
    // (is_video=false, the rest null). The AVFoundation extractor (Step 2b) is the
    // only producer that populates these. ===
    boolean is_video = false;        // discriminator; false for every still
    f64?    duration_seconds = null;
    f64?    frame_rate = null;
    string? video_kind = null;       // container: "mov" / "mp4" / "mxf"
    string? video_codec = null;      // "hevc" / "prores" / "h264"
    i64?    video_bitrate = null;    // bits/sec
    string? color_primaries = null;  // CICP canonical strings (bt2020 / smpte432 / bt709)
    string? color_transfer = null;   // arib-std-b67 (HLG) / smpte2084 (PQ) / bt709
    string? color_matrix = null;     // bt2020nc / smpte170m / bt709
    string? color_range = null;      // "tv" / "pc"
    i32?    dv_profile = null;        // Dolby Vision profile (8 on iPhone); null = none
    boolean? has_audio = null;
    string? audio_codec = null;      // aac / pcm_s16le / pcm_s24le
    i32?    audio_channels = null;
    i32?    audio_sample_rate = null;
    i64?    audio_bitrate = null;    // bits/sec
    string? live_photo_id = null;    // QuickTime content.identifier; pair on equality

    // Apple Photos import provenance (ZASSET.ZUUID); non-null marks an
    // Apple-managed row and is the PhotoKit handle for on-demand materialize.
    string? external_source_id = null;
};

// Represents a complete image record from the database
// Includes database-generated fields (id, indexed_timestamp)
dictionary ImageRecord {
    // Database-generated fields
    i64 id;
    string indexed_timestamp;

    // File system properties
    string file_path;
    u64 file_size;
    string file_name;
    string? file_extension;
    i64 created_timestamp;
    i64 modified_timestamp;

    // Camera/capture metadata
    string? camera_make;
    string? camera_model;
    string? lens_model;
    f64? focal_length;
    f64? aperture;
    f64? shutter_speed;
    u32? iso;
    string? capture_datetime;

    // Image properties
    u32? pixel_width;
    u32? pixel_height;
    string? color_space;
    u32? bit_depth;

    // GPS coordinates
    f64? gps_latitude;
    f64? gps_longitude;
    f64? gps_altitude;

    // IPTC/copyright
    string? copyright;
    string? creator;
    string? description;

    // Organization metadata
    u8? rating;
    string? flag;
    string? color_label;
    i32 rotation;

    // Cross-directory duplicate consolidation (DESIGN-Duplicate-Consolidation.md).
    // Computed at query time via window function over the result set.
    // NULL for singletons (no duplicates in catalogue) and rows whose
    // capture_datetime IS NULL (exempt). For duplicate groups, equal to the
    // id of the row with the lexicographically smallest file_path. The Swift
    // gallery filter shows only rows where Int64(id) == duplicate_group_id
    // when "Show duplicates" is OFF.
    i64? duplicate_group_id;
};

// S74 — video-exclusive read model for the detail panel (Option-returned by
// get_video_details). Mirrors the video-only columns on `images`. Kept separate
// from ImageRecord so the bulk record lift (gallery / ⌘A / 167k builder load,
// all @MainActor — S57) isn't weighted with fields only the panel reads. The
// shared fields a video also carries live on ImageRecord.
dictionary VideoDetails {
    f64? duration_seconds;       // container duration, seconds
    f64? frame_rate;             // nominal fps (e.g. 29.97)
    string? video_kind;          // container: "mov" / "mp4" / "mxf"
    string? video_codec;         // "hevc" / "prores" / "h264"
    i64? video_bitrate;          // bits/sec
    string? color_primaries;     // CICP: "bt2020" / "smpte432" (P3) / "bt709"
    string? color_transfer;      // "arib-std-b67" (HLG) / "smpte2084" (PQ) / "bt709"
    string? color_matrix;        // "bt2020nc" / "smpte170m" / "bt709"
    string? color_range;         // "tv" (limited) / "pc" (full)
    i32? dv_profile;             // Dolby Vision profile (8 on iPhone); null = none
    boolean? has_audio;
    string? audio_codec;         // "aac" / "pcm_s16le" / "pcm_s24le"
    i32? audio_channels;
    i32? audio_sample_rate;
    i64? audio_bitrate;          // bits/sec
    string? live_photo_id;       // QuickTime content.identifier
};

// A9: Result wrapper for `get_file_paths_for_filters`.
//
// Distinguishes a genuine failure (catalogue not initialized, SQL prepare
// or query error) from a legitimate empty-result success — required because
// this codebase signals errors via sentinel/wrapper dictionaries rather
// than `[Throws]` (consistent with every other FFI surface in the .udl).
//
// Contract:
// - ok == true: query succeeded. `paths` holds the matching file_path
//   values (possibly empty); `error_message` is null.
// - ok == false: query failed. `paths` is empty; `error_message` carries
//   a human-readable diagnostic (also logged via eprintln! on the Rust
//   side for parallel observability).
dictionary FilePathsResult {
    boolean ok;
    sequence<string> paths;
    string? error_message;
};

// Source-panel relocate result (S51). ok = committed (or nothing to move);
// updated = rows whose file_path + directory_path were rewritten; message =
// short diagnostic on failure (e.g. a UNIQUE path collision), empty on success.
dictionary RelocateResult {
