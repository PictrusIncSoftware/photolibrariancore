namespace photolibrariancore {
    // Initialize the catalogue database at the given path
    // Returns true if successful, false on error
    [Async]
    boolean initialize_catalogue(string catalogue_path);

    // Ingest a batch of image metadata records into the catalogue
    // Returns the number of records successfully inserted
    [Async]
    u32 ingest_metadata(sequence<ImageMetadata> metadata);

    // Lightroom catalog import (Docs/DESIGN-Lightroom-Catalog-Import.md).
    // Merge a chunk of LR-sourced records into the catalogue (matched on
    // file_path; per-row check-then-UPDATE-or-INSERT). Reuses ImageMetadata as
    // the image input (an exact superset of what LR provides). Returns per-chunk
    // {inserted, updated} + the resulting catalogue ids aligned to input order
    // (for the keyword pass). Videos go to the separate `videos` table.
    [Async]
    MergeChunkResult merge_lightroom_records(sequence<ImageMetadata> records);
    [Async]
    MergeChunkResult merge_lightroom_videos(sequence<LightroomVideoRecord> records);

    // Get the total count of images in the catalogue.
    // Step 4a (Filter-Aware Pagination): accepts the two filter booleans
    // (apply_duplicate_filter, apply_raw_jpeg_collapse) so the total matches
    // what the paginated SELECTs will return for the same filter state.
    [Async]
    u64 get_image_count(boolean apply_duplicate_filter, boolean apply_raw_jpeg_collapse, MediaType media_type);

    // Get images from the catalogue with pagination support
    // Returns a paginated list of image records ordered by ID
    // limit: maximum number of records to return (page size)
    // offset: number of records to skip (page_number * page_size)
    // apply_duplicate_filter / apply_raw_jpeg_collapse: Step 4a filter booleans.
    [Async]
    sequence<ImageRecord> get_all_images(u32 limit, u32 offset, boolean apply_duplicate_filter, boolean apply_raw_jpeg_collapse, MediaType media_type);

    // Get images from the catalogue with pagination and proper global sort order
    // Returns a paginated list of image records ordered by capture_datetime DESC NULLS LAST, created_timestamp DESC
    // limit: maximum number of records to return (page size)
    // offset: number of records to skip (page_number * page_size)
    // apply_duplicate_filter / apply_raw_jpeg_collapse: Step 4a filter booleans.
    [Async]
    sequence<ImageRecord> get_images_sorted(u32 limit, u32 offset, boolean apply_duplicate_filter, boolean apply_raw_jpeg_collapse);

    // Update the rating for an image identified by file path
    // rating: Star rating from 0-5 (0 clears the rating)
    // Returns true on success, false on failure
    [Async]
    boolean update_image_rating(string file_path, u32 rating);

    // Update the pick/reject flag for an image identified by file path
    // flag: "pick" or "reject"; null (or any value outside that set) clears the flag
    // Returns true on success, false on failure (incl. an invalid non-null value)
    [Async]
    boolean update_image_flag(string file_path, string? flag);

    // Update the color label for an image identified by file path
    // color_label: "red"/"yellow"/"green"/"blue"/"purple"; null (or any value
    // outside that set) clears the label
    // Returns true on success, false on failure (incl. an invalid non-null value)
    [Async]
    boolean update_image_color_label(string file_path, string? color_label);

    // Source-panel relocate (S51): bulk re-point every catalogued row under
    // old_prefix to new_prefix (rewrites file_path + the stored directory_path
    // in one transaction; rolls back on a UNIQUE collision). No re-scan.
    [Async]
    RelocateResult relocate_file_path_prefix(string old_prefix, string new_prefix);

    // ---- Filter / Query Builder (structured query) ----
    // Build a dynamic WHERE from a list of filter segments joined LEFT-TO-
    // RIGHT by connectors (predicates.len() == connectors.len() + 1).
    // Delegates to the SAME record/count helpers as every other query, so
    // count/page parity holds by construction. Default sort
    // (capture_datetime DESC). See DESIGN-Filter-Query-Builder.md.
    [Async]
    sequence<ImageRecord> query_images(
        sequence<QueryPredicate> predicates,
        sequence<Connector> connectors,
        u32 limit,
        u32 offset,
        boolean apply_duplicate_filter,
        boolean apply_raw_jpeg_collapse,
        MediaType media_type
    );

    [Async]
    u64 count_query_images(
        sequence<QueryPredicate> predicates,
        sequence<Connector> connectors,
        boolean apply_duplicate_filter,
        boolean apply_raw_jpeg_collapse,
        MediaType media_type
    );

    [Async]
    sequence<ImageRecord> query_images_gallery(
        sequence<QueryPredicate> predicates,
        sequence<Connector> connectors,
        u32 limit,
        u32 offset,
        boolean apply_duplicate_filter,
        boolean apply_raw_jpeg_collapse,
        boolean apply_similar_photo_collapse,
        string similar_algorithm_version,
        MediaType media_type
    );

    [Async]
    u64 count_query_images_gallery(
        sequence<QueryPredicate> predicates,
        sequence<Connector> connectors,
        boolean apply_duplicate_filter,
        boolean apply_raw_jpeg_collapse,
        boolean apply_similar_photo_collapse,
        string similar_algorithm_version,
        MediaType media_type
    );

    // Gallery Query Builder scoped by the current Sources/Dates selection.
    // Keeps Browse on query_images while Gallery can express:
    //   (query sentence) AND (sidebar scope)
    // without OR clauses leaking across the flat connector model.
    [Async]
    sequence<ImageRecord> query_images_scoped(
        sequence<QueryPredicate> predicates,
        sequence<Connector> connectors,
        sequence<QueryPredicate> scope_predicates,
        sequence<Connector> scope_connectors,
        u32 limit,
        u32 offset,
        boolean apply_duplicate_filter,
        boolean apply_raw_jpeg_collapse,
        MediaType media_type
    );

    [Async]
    u64 count_query_images_scoped(
        sequence<QueryPredicate> predicates,
        sequence<Connector> connectors,
        sequence<QueryPredicate> scope_predicates,
        sequence<Connector> scope_connectors,
        boolean apply_duplicate_filter,
        boolean apply_raw_jpeg_collapse,
        MediaType media_type
    );

    [Async]
    sequence<ImageRecord> query_images_scoped_gallery(
        sequence<QueryPredicate> predicates,
        sequence<Connector> connectors,
        sequence<QueryPredicate> scope_predicates,
        sequence<Connector> scope_connectors,
        u32 limit,
        u32 offset,
        boolean apply_duplicate_filter,
        boolean apply_raw_jpeg_collapse,
        boolean apply_similar_photo_collapse,
        string similar_algorithm_version,
        MediaType media_type
    );

    [Async]
    u64 count_query_images_scoped_gallery(
        sequence<QueryPredicate> predicates,
        sequence<Connector> connectors,
        sequence<QueryPredicate> scope_predicates,
        sequence<Connector> scope_connectors,
        boolean apply_duplicate_filter,
        boolean apply_raw_jpeg_collapse,
        boolean apply_similar_photo_collapse,
        string similar_algorithm_version,
        MediaType media_type
    );

    // Browse multi-select (Session 44). query_image_ids returns the IDs of
    // every row matching the filter (⌘A "select the whole query");
    // get_images_by_ids resolves a selection (any IDs, cross-page or whole-
    // query) to full records for Copy/Reveal; the three update_*_for_ids do
    // bulk curation in ONE statement.
    [Async]
    sequence<i64> query_image_ids(
        sequence<QueryPredicate> predicates,
        sequence<Connector> connectors,
        boolean apply_duplicate_filter,
        boolean apply_raw_jpeg_collapse,
        MediaType media_type
    );

    [Async]
    sequence<ImageRecord> get_images_by_ids(sequence<i64> ids);

    // Expand visible IDs to include hidden RAW collapse-siblings (so an action
    // on a collapsed row reaches the RAW too, when the collapse toggle is on).
    [Async]
    sequence<i64> expand_collapse_group_ids(sequence<i64> ids);

    [Async]
    u64 update_flag_for_ids(sequence<i64> ids, string? flag);

    [Async]
    u64 update_color_label_for_ids(sequence<i64> ids, string? color_label);

    [Async]
    u64 update_rating_for_ids(sequence<i64> ids, u32 rating);

    // ---- Durable analysis jobs / background enrichment coordinator ----
    // Generic job rows used by intelligent culling now and by the future
    // background helper. The current focus queue remains image-column-derived;
    // these rows track the run identity, scope, counters, cancel request, and
    // terminal status across app/helper process boundaries.
    [Async]
    AnalysisJob? create_analysis_job(
        string job_kind,
        string scope_kind,
        string? scope_value,
        string algorithm_version,
        string analysis_run_id,
        u64 total_candidate_count
    );

    [Async]
    AnalysisJob? active_analysis_job(string job_kind);

    [Async]
    sequence<AnalysisJob> active_analysis_jobs();

    [Async]
    AnalysisJob? update_analysis_job_progress(
        i64 id,
        u64 processed_delta,
        u64 completed_delta,
        u64 skipped_delta,
        u64 failed_delta,
        u64 updated_delta,
        u64? total_candidate_count
    );

    [Async]
    AnalysisJob? update_analysis_job_breadcrumb(
        i64 id,
        i64? current_image_id,
        string? current_file_path,
        boolean timed_out
    );

    [Async]
    boolean request_cancel_analysis_job(i64 id);

    [Async]
    AnalysisJob? finish_analysis_job(i64 id, string status, string? last_error);

    [Async]
    u64 recover_interrupted_analysis_jobs(
        string job_kind,
        string terminal_status,
        string? last_error
    );

    // ---- Keyword system (Session 45; Docs/DESIGN-Keyword-System.md) ----
    // Hierarchical keywords in a single `keyword` table. assign materializes a
    // path's ancestor chain (one row per level) for each image; remove/restore
    // soft-hide / un-hide a node + its descendants; reparent/rename re-
    // materialize a subtree GLOBALLY. Reads: keywords_for_image (per-photo
    // reconstruction), keyword_vocabulary (autocomplete), and
    // hidden_keywords_for_image (the recovery surface). All catalogue-only
    // (cloud-safe). Mutators return an affected-count; reads return rows.
    [Async]
    u64 assign_keyword_for_ids(sequence<i64> ids, sequence<string> segments);

    [Async]
    u64 remove_keyword_for_ids(sequence<i64> ids, string path);

    [Async]
    u64 restore_keyword_for_ids(sequence<i64> ids, string path);

    // S67: copy keyword rows across RAW<->JPEG/HEIF pair siblings (same stem +
    // same directory) so both halves match — the sidecar-import parity heal.
    // Set-based, idempotent; whole rows (status/collection/color) ride along.
    [Async]
    u64 mirror_keyword_rows_across_pairs();

    // S67: copy keyword rows from source images to their catalogued copies —
    // the Copy-and-Import inheritance step. Explicit (source, destination)
    // pairs aligned by index; idempotent; whole rows ride along.
    [Async]
    u64 copy_keyword_rows_for_image_pairs(sequence<i64> source_ids, sequence<i64> destination_ids);

    [Async]
    u64 reparent_keyword(sequence<string> source_path, sequence<string> new_parent);

    [Async]
    u64 rename_keyword(sequence<string> target_path, string new_label);

    [Async]
    sequence<KeywordRow> keywords_for_image(i64 image_id);

    [Async]
    sequence<KeywordNode> keyword_vocabulary();

    [Async]
    sequence<KeywordNode> keyword_vocabulary_for_origin(string origin);

    // Settings → Keywords management. Reads the raw keyword table so hidden
    // orphaned rows and collection-backed rows can be inspected/cleaned without
    // changing normal keyword/query vocabulary behavior.
    [Async]
    sequence<KeywordManagementRow> keyword_management_rows(
        string origin,
        boolean include_collections,
        boolean include_orphaned
    );

    // Physically purge keyword rows for the selected path(s), including
    // descendants. Separate from remove_keyword_for_ids, which soft-hides.
    [Async]
    u64 delete_keyword_paths(sequence<string> paths);

    [Async]
    sequence<KeywordRow> hidden_keywords_for_image(i64 image_id);

    // ---- Collections (the `collection` switch on the keyword row) ----
    // keyword_labels: ALL distinct visible keyword labels — the Add dialog's
    //   autofill/dropdown (any label can seed a collection; flag-agnostic).
    // add_images_to_collections: the "Apply" — per image x label, flip the
    //   `collection` switch ON (or insert a flat collection row). Idempotent.
    [Async]
    sequence<string> keyword_labels();

    [Async]
    u64 add_images_to_collections(sequence<i64> ids, sequence<string> labels);

    // remove_images_from_collections: the scope-gated "Remove from <collection>"
    //   — per image x label, flip the `collection` switch OFF (deliberately NO
    //   status filter: hidden-keyword members must stay reachable). Rows are
    //   never deleted. Idempotent.
    [Async]
    u64 remove_images_from_collections(sequence<i64> ids, sequence<string> labels);

    // collection_labels: collections ONLY (labels with collection = TRUE on any
    //   row, raw table — membership is independent of visibility) — the gallery
    //   "Select Collection" picker (the opposite of keyword_labels' list).
    [Async]
    sequence<string> collection_labels();

    // ---- Color labels (the `color` switch on the keyword row — S66) ----
    // assign_color_keyword_for_ids: the Lightroom import's color pass — mark a
    //   CUSTOM color-label text on a batch of images: flip `color = TRUE` on an
    //   existing visible row with that label, else insert a flat color row.
    //   Idempotent. (The five standard color names never come here — they live
    //   in images.color_label.)
    [Async]
    u64 assign_color_keyword_for_ids(sequence<i64> ids, string label);

    // ---- Saved Queries (Session 63; Docs/DESIGN-Saved-Queries.md) ----
    // save_query: write the sentence down under `name`; a colliding name gains
    //   a -01/-02 suffix (never replace, never prompt — Richard's rule). The
    //   returned header carries the FINAL name. Null = invalid input/failure.
    // load_saved_query: rows -> the same (predicates, connectors) arrays
    //   query_images consumes. Null = unknown id.
    [Async]
    SavedQueryInfo? save_query(string name, sequence<QueryPredicate> predicates, sequence<Connector> connectors);

    [Async]
    sequence<SavedQueryInfo> list_saved_queries();

    [Async]
    SavedQueryPayload? load_saved_query(i64 id);

    [Async]
    boolean delete_saved_query(i64 id);

    // distinct_image_values: distinct stored values of one ALLOW-LISTED images
    //   column ("file_extension" / "image_kind" / "camera_make" /
    //   "camera_model" / "lens_model" / "creator") — the metadata subjects'
    //   type-ahead source (S63). Unknown field token -> empty.
    [Async]
    sequence<string> distinct_image_values(string field);

    // distinct_numeric_values: the numeric twin (S65) — distinct stored values
    //   of one ALLOW-LISTED exposure column ("iso" / "aperture" /
    //   "shutter_speed" / "focal_length") as exact doubles, ascending. The
    //   numeric subjects' "is exactly" dropdown source.
    [Async]
    sequence<f64> distinct_numeric_values(string field);

    // ---- Intelligent culling / focus analysis (S76) ----
    // Queue is derived from NULL/stale focus columns, not a separate persisted
    // table. Swift analyzes these candidates off-main and writes scalar results
    // back in batches.
    [Async]
    sequence<FocusAnalysisCandidate> focus_analysis_candidates(u32 limit, string algorithm_version, string analysis_run_id);

    [Async]
    sequence<FocusAnalysisCandidate> focus_analysis_candidates_for_ids(sequence<i64> ids, u32 limit, string algorithm_version, string analysis_run_id);

    [Async]
    u64 focus_analysis_candidate_count(string algorithm_version, string analysis_run_id);

    [Async]
    u64 focus_analysis_candidate_count_for_ids(sequence<i64> ids, string algorithm_version, string analysis_run_id);

    [Async]
    u64 update_focus_analysis_results(sequence<FocusAnalysisResult> results);

    [Async]
    u64 face_observation_count(string algorithm_version);

    [Async]
    sequence<FaceObservationRecord> face_observations_for_image_ids(sequence<i64> ids, string algorithm_version);

    // Developer-only face embedding vector store (AuraFace validation path).
    // Vectors live in LanceDB beside the catalogue, keyed by face_observation.id
    // plus model/preprocessing versions so future alignment/model migrations can
    // coexist or regenerate safely.
    [Async]
    FaceEmbeddingStoreResult upsert_face_embeddings(sequence<FaceEmbeddingVectorRecord> records);

    [Async]
    u64 face_embedding_count(string model_version, string preprocessing_version);

    [Async]
    sequence<FaceEmbeddingNeighborRecord> face_embedding_nearest_neighbors(string model_version, string preprocessing_version, u32 limit_per_face);

    [Async]
    u64 replace_face_cluster_run(FaceClusterRunRecord run, sequence<FaceClusterMemberRecord> members);

    [Async]
    sequence<FaceClusterMemberRecord> face_cluster_members(string run_id);

    // Similar-photo grouping (S94): Swift computes Vision feature-print groups
    // after Intelligent Culling and persists only multi-photo memberships here.
    [Async]
    sequence<SimilarPhotoCandidate> similar_photo_candidates(string algorithm_version);

    [Async]
    sequence<SimilarPhotoCandidate> similar_photo_candidates_for_ids(sequence<i64> ids, string algorithm_version);

    [Async]
    sequence<SimilarPhotoFeatureprint> similar_photo_featureprints_for_ids(sequence<i64> ids, string algorithm_version);

    [Async]
    u64 upsert_similar_photo_featureprints(sequence<SimilarPhotoFeatureprint> entries, string algorithm_version);

    [Async]
    sequence<SimilarPhotoWorkUnit> completed_similar_photo_work_units(string algorithm_version, string scope_key);

    [Async]
    boolean mark_similar_photo_work_unit_complete(string algorithm_version, string scope_key, SimilarPhotoWorkUnit unit);

    [Async]
    sequence<SimilarPhotoStackSummary> similar_photo_stack_summaries_for_ids(sequence<i64> ids, string algorithm_version);

    [Async]
    sequence<SimilarPhotoStackMember> similar_photo_stack_members_for_ids(sequence<i64> ids, string algorithm_version);

    [Async]
    u64 replace_similar_photo_groups(sequence<SimilarPhotoGroupMember> members, string algorithm_version);

    [Async]
    u64 replace_similar_photo_groups_for_ids(sequence<i64> ids, sequence<SimilarPhotoGroupMember> members, string algorithm_version);

    [Async]
    u64 upsert_similar_photo_groups_for_ids(sequence<i64> ids, sequence<SimilarPhotoGroupMember> members, string algorithm_version);

    // Update the rotation angle for an image identified by file path
    // degrees: Rotation angle in degrees (0, 90, 180, or 270)
    // Returns true on success, false on failure
    [Async]
    boolean update_image_rotation(string file_path, i32 degrees);

    // Get all distinct date strings from capture_datetime for date navigation
    // Returns date prefixes in "YYYY:MM:DD" format, sorted descending (newest first)
    [Async]
    sequence<string> get_distinct_date_strings();

    // Get all distinct parent directory paths from catalogued images
    // Returns directory paths sorted alphabetically, used for source locations tree
    [Async]
    sequence<string> get_distinct_directory_paths();

    // ---- Aggregated sidebar counts (S65 — the cure for the per-node COUNT
    // flood flagged in S64). ONE GROUP BY per sidebar replaces thousands of
    // sequential per-node queries; the row keys double as the distinct-paths /
    // distinct-days lists, so each call also supersedes the structure query
    // above for its sidebar. Counts are RAW catalogue (no duplicate filter,
    // no RAW+JPEG collapse — the §11 sidebar convention); Swift sums
    // ancestors (directories) and months/years (days) in memory.
    [Async]
    sequence<DirectoryImageCount> directory_image_counts(MediaType media_type);

    [Async]
    sequence<CaptureDayImageCount> capture_day_image_counts(MediaType media_type);

    // Get images with pagination and optional date filtering
    // date_prefix: Empty string for all images, or "YYYY:", "YYYY:MM:", "YYYY:MM:DD" for filtering
    // apply_duplicate_filter / apply_raw_jpeg_collapse: Step 4a filter booleans.
    // Returns paginated list ordered by capture_datetime DESC NULLS LAST, created_timestamp DESC
    [Async]
    sequence<ImageRecord> get_images_filtered(i64 limit, i64 offset, string date_prefix, boolean apply_duplicate_filter, boolean apply_raw_jpeg_collapse);

    // Get count of images matching the date filter
    // date_prefix: Empty string for all images, or "YYYY:", "YYYY:MM:", "YYYY:MM:DD" for filtering
    // apply_duplicate_filter / apply_raw_jpeg_collapse: Step 4a filter booleans.
    [Async]
    i64 get_filtered_image_count(string date_prefix, boolean apply_duplicate_filter, boolean apply_raw_jpeg_collapse, MediaType media_type);

    // Get count of images in a directory (matching path prefix)
    // path_prefix: Directory path prefix (e.g., "/Users/richard/Photos/")
    // apply_duplicate_filter / apply_raw_jpeg_collapse: Step 4a filter booleans.
    [Async]
    i64 get_image_count_for_path_prefix(string path_prefix, boolean apply_duplicate_filter, boolean apply_raw_jpeg_collapse);

    // Get images from a directory with pagination (matching path prefix)
    // Supports both path and date filtering simultaneously.
    // apply_duplicate_filter / apply_raw_jpeg_collapse: Step 4a filter booleans.
    [Async]
    sequence<ImageRecord> get_images_for_path_prefix(i64 limit, i64 offset, string path_prefix, string date_prefix, boolean apply_duplicate_filter, boolean apply_raw_jpeg_collapse, MediaType media_type);

    [Async]
    sequence<ImageRecord> get_images_for_path_prefix_gallery(
        i64 limit,
        i64 offset,
        string path_prefix,
        string date_prefix,
        boolean apply_duplicate_filter,
        boolean apply_raw_jpeg_collapse,
        boolean apply_similar_photo_collapse,
        string similar_algorithm_version,
        MediaType media_type
    );

    // Get count of images matching both path prefix and date filter
    // apply_duplicate_filter / apply_raw_jpeg_collapse: Step 4a filter booleans.
    [Async]
    i64 get_image_count_for_filters(string path_prefix, string date_prefix, boolean apply_duplicate_filter, boolean apply_raw_jpeg_collapse, MediaType media_type);

    [Async]
    i64 get_image_count_for_filters_gallery(
        string path_prefix,
        string date_prefix,
        boolean apply_duplicate_filter,
        boolean apply_raw_jpeg_collapse,
        boolean apply_similar_photo_collapse,
        string similar_algorithm_version,
        MediaType media_type
    );

    // A9 (sidebar bulk-copy enumeration foundation): return the set of
    // `file_path` values matching the gallery's current filter state via
    // a projection-only query — avoids dragging full ImageRecord rows
    // across the FFI when only the paths are needed.
    //
    // Parity-by-construction: shares the same predicate constants and
    // assembly path as `get_images_for_path_prefix` /
    // `get_image_count_for_filters`. Caller is responsible for argument
    // polarity (e.g., pass `!showDuplicates` for `apply_duplicate_filter`).
    //
    // Error vs empty: result.ok == false signals a genuine failure
    // (catalogue not initialized, prepare/query error) with
    // error_message populated and paths empty. result.ok == true with an
    // empty paths sequence is a valid success indicating zero matches.
    //
    // Order: unspecified. Path strings are returned exactly as stored.
    [Async]
    FilePathsResult get_file_paths_for_filters(string path_prefix, string date_prefix, boolean apply_duplicate_filter, boolean apply_raw_jpeg_collapse, MediaType media_type);

    // A10 (sidebar bulk-copy records enumeration): records-returning
    // sibling of `get_file_paths_for_filters`. Returns the full
    // `ImageRecord` set matching the current filter state, unordered,
    // no LIMIT/OFFSET. Consumed by `CopyPlanner.planGroups*` for the
    // sidebar right-click "Copy To…" flow.
    //
    // Mirror of the established record-returning convention: returns
    // an empty sequence on failure (NOT a wrapper dict). Diagnostics
    // logged via eprintln! on the Rust side.
    //
    // Parity-by-construction with A9 — same predicate builder, same
    // filter constants. Caller owns argument polarity. Sidebar callers
    // pass `false, false` (raw catalogue truth, independent of gallery
    // view preferences).
    [Async]
    sequence<ImageRecord> get_image_records_for_filters(string path_prefix, string date_prefix, boolean apply_duplicate_filter, boolean apply_raw_jpeg_collapse, MediaType media_type);

    // Session 31: catalogue-only bulk DELETE for the Sources sidebar's
    // "Remove from Catalogue" context-menu action. Deletes every row
    // matching the SAME path/date predicate `get_image_records_for_filters`
    // would have read — predicate parity-by-construction via the shared
    // `build_path_date_predicate` builder. Touches NO files, NO thumbnails.
    //
    // Safety guard: if both prefixes are empty (would yield an empty
    // WHERE clause and risk a catalogue wipe), the call is refused and
    // 0 is returned. The Sources caller always passes a non-empty
    // path_prefix; the guard exists to bound the blast radius for any
    // future caller that drifts.
    //
    // Returns: number of rows deleted, as i64. Returns 0 on any failure
    // (catalogue uninitialized, empty-predicate refusal, SQL error) —
    // mirroring `get_image_count_for_path_prefix`'s failure-as-zero
    // convention. Diagnostic detail goes to stderr.
    [Async]
    i64 remove_images_for_filters(string path_prefix, string date_prefix);

    // ---- Folder Sync (Session 68; Docs/DESIGN-Folder-Sync.md) ----
    // directory_sync_states: the sweep baseline — one row per catalogued
    //   directory carrying its on-disk mtime as of its last scan/sync. The
    //   monitor stats each catalogued directory and flags on INEQUALITY
    //   (a restore-from-backup moves mtime backward; still changed). A
    //   directory with no row compares as changed — first sync seeds it.
    [Async]
    sequence<DirectorySyncState> directory_sync_states();

    // update_directory_sync_states: bulk check-then-UPDATE-or-INSERT of the
    //   post-walk truth (one transaction), called at the end of every scan
    //   and every sync; also prunes rows whose directory left the catalogue.
    //   Returns rows changed (prune uncounted); 0 = failure or empty input.
    [Async]
    u64 update_directory_sync_states(sequence<DirectorySyncState> states);

    // remove_images_by_ids: catalogue-only DELETE of EXPLICIT image rows — the
    //   full-sync removal half. Swift has already stat-confirmed each file
    //   missing on a healthy (mounted, accessible) root AND shown the named
    //   confirm. Keyword rows are never touched (S31/S65 doctrine). Touches
    //   no files, no thumbnails. Refuses an empty list.
    [Async]
    u64 remove_images_by_ids(sequence<i64> ids);

    // Session 30 (cross-plan overwrite-gap fix): return the destination
    // "family" at a given basePath — canonical row + any NN_version_
    // siblings (two leading digits) in the same directory_path. Used by
    // CopyPlanner to pre-seed versionCountByBasePath from the catalogue,
    // closing the silent-overwrite seam between sequential copy plans
    // (e.g. two card imports). See get_destination_family_records doc
    // in lib.rs and the "Copy To — Cross-Plan Overwrite Gap" section
    // in CLAUDE.md.
    //
    // sample_file_path: a sample destination file_path string. Rust
    // derives directory_path from it via the SAME SUBSTRING/INSTR/REVERSE
    // expression used at ingest — match-by-construction, no Swift-side
    // directory string in flight to drift.
    //
    // canonical_file_name: the unprefixed canonical filename for the
    // basePath collision group, e.g. "RSW_0001.NEF".
    //
    // Returns: every catalogued ImageRecord in the family, in
    // UNSPECIFIED order. Empty Vec on failure (matches the established
    // record-returning convention). Bypasses the duplicate filter and
    // RAW+JPEG collapse — catalogue truth, not gallery view.
    [Async]
    sequence<ImageRecord> get_destination_family_records(string sample_file_path, string canonical_file_name);

    // Find the JPEG<->RAW counterpart for an image identified by file_path.
    // Returns the opposite-kind sibling sharing the same parent directory and
    // file-name stem (e.g. given /Pics/IMG_1234.NEF, returns /Pics/IMG_1234.JPG
    // if present in the catalogue). Returns null when:
    //   - no opposite-kind sibling exists,
    //   - the input is classified as Other,
    //   - the input path lacks a parent directory or extension,
    //   - the catalogue is not initialized.
    // Comparison is byte-exact and case-sensitive for v1.
    [Async]
    ImageRecord? find_counterpart_image(string file_path);

    // S74 — the video-exclusive columns for the detail panel's Video group,
    // fetched on demand for one video by id. Returns null when the id is absent
    // or the row is not a video (`is_video IS TRUE` guards it — the caller only
    // asks for videos). The shared fields a video also has (capture date,
    // dimensions, rotation, bit depth, color space, GPS) ride on ImageRecord;
    // these stay OFF the bulk-lifted record (gallery / ⌘A / builder loads are
    // @MainActor — S57) so the hot path isn't weighted with panel-only fields.
    [Async]
    VideoDetails? get_video_details(i64 image_id);

    // S87 — the Apple asset UUID (external_source_id, the ZASSET.ZUUID stored at
    // Apple Photos import) for one image by id. The Phase 2 PhotoKit handle for
    // materializing a cloud-only Apple original on demand. Single-row, by id;
    // returns null when the id is absent or the column is NULL (an ordinary
    // non-Apple row). Kept OFF the bulk ImageRecord lift (gallery / ⌘A / builder
    // loads are @MainActor — S57), mirroring get_video_details.
    [Async]
    string? get_external_source_id(i64 image_id);

    // Classify a file extension into JPEG, RAW, or Other.
    // SYNCHRONOUS — first sync export in this project. Pure string-to-enum
    // lookup; no I/O, no DuckDB access. Forcing it async would push the
    // Swift-side consumer (a SwiftUI computed property that cannot await)
    // into awkward shapes.
    // ext: file extension without leading dot, case-insensitive (e.g., "jpg", "NEF").
    ImageKind classify_extension(string ext);

    // A11 (editor default preferences): project the canonical RAW
    // extension list to Swift. PreferencesView's "Default RAW editor"
    // picker needs to enumerate every recognized RAW extension to
    // compute the intersection of LaunchServices-capable apps across
    // all of them. SYNCHRONOUS — pure projection of a compile-time
    // const; mirrors classify_extension's sync precedent. Returns
    // lowercase, no-leading-dot extensions in declaration order.
    sequence<string> get_raw_extensions();

    // A11 companion to get_raw_extensions. The "Default JPEG editor"
    // picker queries by UTType.jpeg directly and does not strictly
    // need this list today, but exposing it keeps symmetry with the
    // RAW projection and avoids per-extension classify_extension
    // calls if a future Swift consumer needs to know which extensions
    // classify as JPEG. SYNCHRONOUS — same rationale.
    sequence<string> get_jpeg_extensions();

    // Parse a filename into stem, lowercased extension, and ImageKind.
    // SYNCHRONOUS — same rationale as classify_extension. Composes on top of
    // classify_extension; see DESIGN-Duplicate-Consolidation.md §7 for the
    // canonical parsing rule and the "metype" placeholder convention for
    // malformed/missing extensions.
    // file_name: a filename without directory components (no slashes).
    ParsedFilename parse_filename(string file_name);
};

// Image classification categories for JPEG+RAW pair handling.
// Eight variants — Jpeg, Raw, Other, Heif, Dng, Psd, Tiff, Png. Other is a real
// category, not a "not RAW" bucket. Heif (heic/heif/hif) was promoted out of
// Other in Session 41 so it can participate in RAW pair-collapse like JPEG.
// The Lightroom-import work (Docs/DESIGN-Lightroom-Catalog-Import.md §7)
// promoted DNG out of Raw and PSD/TIFF/PNG out of Other to their own kinds —
// none of the four participate in pair-collapse.
// First enum exposed across the UniFFI boundary in this project.
// NOTE: variant ORDER must match the Rust `enum ImageKind` (UniFFI maps by
// position) — new variants are appended LAST in both to keep existing
// discriminants stable.
enum ImageKind {
    "Jpeg",
    "Raw",
    "Other",
    "Heif",
    "Dng",
    "Psd",
    "Tiff",
    "Png",
};

// Boolean connector between two filter segments (Query Builder), applied
// LEFT-TO-RIGHT (no operator precedence). Variant ORDER must match the Rust
// `enum Connector` (UniFFI maps by position).
enum Connector {
    "And",
    "Or",
    "Xor",
};

// Three-state media-type view stance (DESIGN-Video-Schema-Unified-Table.md §11),
// the three-state sibling of the apply_duplicate_filter / apply_raw_jpeg_collapse
// view booleans. Threaded through the shared query helpers + the two sidebar-
// count fns; selects stills-only / videos-only / both. Variant ORDER must match
// the Rust `enum MediaType` (UniFFI maps by position).
enum MediaType {
    "StillsOnly",
    "VideosOnly",
    "Both",
};

// One filter segment (one clause of the filter sentence), flattened for the
// FFI. `kind` selects which fields are meaningful; the Swift side holds the
// strong FilterSegment type and serializes to this. Modelled as a dictionary
// (not an associated-data enum) to use only UDL features the project already
// relies on. See DESIGN-Filter-Query-Builder.md §10 for the kind→fields map:
//   "date_equals"       → day
//   "date_between"      → day (start), day_end (end)
//   "date_after"        → day            (on or after)
//   "date_before"       → day            (on or before)
//   "rating"            → op (eq/gt/lt/gte/lte), stars (1..5)
//   "rating_unrated"    → (none)
//   "flag"              → value ("pick"/"reject")
//   "flag_or_unflagged" → value ("pick"/"reject")  → value OR NULL
//   "unflagged"         → (none)
//   "color"             → value ("red".."purple")
//   "no_color"          → (none)
//   "keyword_has"       → value (the keyword label), op? ("both"/"user"/"auto")  → EXISTS (subtree-inclusive)
//   "keyword_not"       → value (the keyword label), op? ("both"/"user"/"auto")  → NOT EXISTS
//   "filename_contains" → value (text)  → file_name ILIKE %text% (case-insensitive)
//   "filename_starts"   → value (text)  → file_name ILIKE text%
//   "filename_ends"     → value (text)  → file_name ILIKE %text
//   "filename_exact"    → value (text)  → file_name ILIKE text (case-insensitive equality)
dictionary QueryPredicate {
    string kind;
    string? day;
    string? day_end;
    string? op;
    u8? stars;
    string? value;
    // Numeric subjects (S65): "iso_num" / "aperture_num" / "shutter_num" /
    // "focal_num" → op (eq/gte/lte/between) + num (the value or lower bound)
    // + num_end (the "between" upper bound). Appended LAST (UniFFI maps by
    // position); `= null` defaults keep existing Swift constructions valid.
    f64? num = null;
    f64? num_end = null;
};

// One saved query's identity (Session 63, saved queries — the header row).
dictionary SavedQueryInfo {
    i64 id;
    string name;
};

// A loaded saved query: the same two arrays query_images consumes — load,
// hand to the Find in Gallery sheet, run. See Docs/DESIGN-Saved-Queries.md.
dictionary SavedQueryPayload {
    sequence<QueryPredicate> predicates;
    sequence<Connector> connectors;
};

